# ─── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI 프로바이더 API 키 ─────────────────────────────────────────────────
# 사용하는 프로바이더만 설정하면 됩니다.

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Generative AI (Gemini 텍스트 + Nano Banana 이미지)
GOOGLE_GENERATIVE_AI_API_KEY=

# 로컬 LLM (Ollama/vLLM 등 OpenAI 호환 엔드포인트) — 선택사항
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=

# ─── 작업별 모델 라우팅 (선택사항, 미설정 시 기본값 사용) ────────────────
# 형식: provider:model-id
#   anthropic:claude-sonnet-4-5
#   google:gemini-2.5-flash
#   google:gemini-2.5-pro
#   local:llama-3.3-70b
#
# 기본값:
#   analyze     → google:gemini-2.5-flash     (비전, 저비용)
#   naming      → anthropic:claude-sonnet-4-5 (한국어 품질)
#   tagline     → google:gemini-2.5-flash     (짧은 출력)
#   description → anthropic:claude-sonnet-4-5 (한국어 마케팅 톤)

MODEL_ANALYZE=
MODEL_ANALYZE_FALLBACK=
MODEL_NAMING=
MODEL_NAMING_FALLBACK=
MODEL_TAGLINE=
MODEL_TAGLINE_FALLBACK=
MODEL_DESCRIPTION=
MODEL_DESCRIPTION_FALLBACK=

# ─── 개발/테스트 ──────────────────────────────────────────────────────────
# true로 설정하면 크레딧 검사를 우회합니다 (프로덕션 절대 금지)
DEV_BYPASS_CREDITS=

# ─── 트렌드 키워드 외부 API (Phase 3 — 선택사항) ─────────────────────────
# 네이버 검색 트렌드. 미설정 시 정적 fallback 사용.
# 발급: https://developers.naver.com/apps/#/register
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=

# ─── 결제 / 외부 SaaS ────────────────────────────────────────────────────
# Toss Payments — 코드가 읽는 이름 그대로 적어야 한다 (src/lib/env.ts).
#
# [공개값] 빌드 타임에 브라우저 번들로 인라인되는 클라이언트 키 — 어차피 공개되므로
# Vercel 에 Sensitive 로 등록할 실익이 없다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# [비밀값] 서버 전용 시크릿 키. 결제 승인·webhook 검증에서만 사용하며
# 클라이언트로 절대 내보내지 않는다. Vercel 등록 시 Sensitive 권장.
TOSS_SECRET_KEY=

COOLSMS_API_KEY=
COOLSMS_API_SECRET=
COOLSMS_FROM_NUMBER=

NEXT_PUBLIC_KAKAO_JS_KEY=

# ─── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── 상세페이지 서버 래스터화 (선택 — 미설정 시 클라이언트 폴백) ──────────
# render-service(VPS Playwright) 주소와 Bearer 토큰. 둘 다 없으면
# /api/render/detail-page 가 501 + fallback:"client" 로 응답하고 편집기가
# 클라이언트 래스터화로 자동 전환한다. 미배포여도 기능은 동작한다.
DETAIL_RENDER_URL=
# [비밀값]
DETAIL_RENDER_TOKEN=

# ─── Cron (선택) ─────────────────────────────────────────────────────────
# 설정하면 /api/health/db 가 `Authorization: Bearer <값>` 을 요구한다.
# Vercel Cron 은 이 헤더를 자동으로 붙인다. 미설정 시 엔드포인트는 무인증으로
# 열리지만 반환값이 {ok,db,latencyMs} 뿐이라 정보 노출은 없다.
# [비밀값]
CRON_SECRET=
