# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 예외: 실값이 없는 템플릿은 추적한다 (신규 클론에서 cp .env.local.example .env.local 가능)
!.env.local.example

# vercel — .vercel/project.json 은 과거에 추적된 이력이 있다.
# 이미 추적 중인 파일은 이 규칙만으로 제외되지 않으므로 git rm --cached 가 필요하다.
.vercel

# supabase CLI 임시 파일
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude
.claude/

# Environment variables
.env.local
.env.*.local

# render-service (VPS 마이크로서비스) 로컬 설치물
render-service/node_modules
